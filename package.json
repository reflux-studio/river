{
  "name": "river-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter ./apps/desktop dev",
    "dev:site": "pnpm --filter ./apps/site dev",
    "build:site": "pnpm --filter ./apps/site build",
    "dist": "pnpm --filter ./apps/desktop dist",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
