---
// 功能区块的文字栏：小标题、标题（数组按行拆开）、导语
interface Props { eyebrow: string; title: string[] | string; lead: string }
const { eyebrow, title, lead } = Astro.props
const lines = typeof title === 'string' ? [title] : title
---

<div class="flex flex-col gap-4">
  <div class="text-[14px] font-semibold text-brand">{eyebrow}</div>
  <h3 class="m-0 text-[clamp(28px,3.4vw,40px)] leading-[1.15] font-bold tracking-[-0.025em] text-balance">
    {lines.map((l, i) => (<Fragment>{i > 0 && <br />}{l}</Fragment>))}
  </h3>
  <p class="m-0 max-w-[460px] text-[17px] leading-[1.65] text-pretty text-label">{lead}</p>
  <slot />
</div>
