{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "test/**/*",
    "src/renderer/src/lib/feedback-sync.ts", "src/renderer/src/lib/audio-controller.ts",
    "src/renderer/src/lib/river.ts", "src/renderer/src/lib/audio.ts"
  ]
}
